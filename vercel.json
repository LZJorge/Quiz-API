{
  "version": 2,
  "builds": [
    {
      "src": "dist/src/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["dist/**"] }
    },
    {
      "src": "public/**",
      "use": "@vercel/static",
      "config": { "includeFiles": ["public/**"] }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/src/index.js"
    },
    {
      "src": "/(.+)",
      "dest": "public/$1"
    }
  ],
  "outputDirectory": "public"
}
